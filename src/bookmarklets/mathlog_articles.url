javascript:(async()=>{const sec=v=>v==null?null:typeof v.toDate=="function"?v.toDate().getTime()/1000:v.seconds??v._seconds??(typeof v=="string"||typeof v=="number"?new Date(v).getTime()/1000:null);const find=(a,id)=>{const k=Object.keys(a).find(k=>k.startsWith("__reactFiber$"));for(let f=k&&a[k];f;f=f.return){const p=f.memoizedProps;if(p&&typeof p=="object")for(const v of Object.values(p))if(v&&typeof v=="object"&&v.id===id&&"created_at"in v)return sec(v.created_at);}return null;};const rows=[],seen=new Set(),miss=[];for(const a of document.querySelectorAll('.grid.g-cols-1.g-lg-cols-2 a.fw-bold[href^="/articles/"]')){const url=a.getAttribute("href"),id=url.split("/").pop();if(seen.has(url))continue;seen.add(url);const title=a.textContent.replace(/\s+/g," ").trim();const s=find(a,id);if(s==null){miss.push(title);continue;}const d=new Date((Math.floor(s)+9*3600)*1000).toISOString().slice(0,19).replace("T"," ").replaceAll("-","/");rows.push(d+"\t"+url+"\t"+title);}if(miss.length){alert("created_at%E3%81%8C%E5%8F%96%E5%BE%97%E3%81%A7%E3%81%8D%E3%81%BE%E3%81%9B%E3%82%93: "+miss.length+"/"+seen.size+"\n"+miss.join("\n"));return;}await navigator.clipboard.writeText("date\turl\ttitle\n"+rows.join("\n")+"\n");alert("%E3%82%B3%E3%83%94%E3%83%BC%E3%81%97%E3%81%BE%E3%81%97%E3%81%9F ("+rows.length+" %E4%BB%B6)");})();
